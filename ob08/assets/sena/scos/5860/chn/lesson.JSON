ype": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "text", "content": "Instructions: Click on the drop-down list. Select the correct answer.\n"}], "type": "post_instructions"}, {"type": "template_override", "content": 2}]}, {"template_override": 1, "stimuli_ids": [], "questions": [{"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}], "id": 0, "_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}]}], "type": "RSLT", "id": 11, "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le12ob08re2img07.jpg", "audiosrc": "engenn6le12ob08re2aud01", "images": [{"time": "0", "image": "engenn6le12ob08re2img07.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le12ob08re2img07.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Hmm, this is delicious. The beef is so tender, and the caramelized apples were an unexpected treat!<br>\n<span class=\"strong\">Marco</span>: I like to keep you on your toes ... You ought to make this recipe for your friends sometime. Plus, stir fries are healthy. I used to make high-fat meals more often than now.<br>\n<span class=\"strong\">Vanessa</span>: Me, too.  I have changed my eating habits. What is that?<br>\n<span class=\"strong\">Marco</span>: It's is my trusty spork. It's part of my cutlery collection. It's perfect for this kind of meal.<br>\n<span class=\"strong\">Vanessa</span>: What! You actually use that thing ... in public?"}, {"time": "39000", "image": "engenn6le12ob08re2img08.jpg", "id": 2, "text": "<span class=\"strong\">Marco</span>: Yes, I bring it with me wherever I go. It's always in my back pocket.<br>\n<span class=\"strong\">Vanessa</span>: You are so unconventional. You had better not take that to any restaurant with me.<br>\n<span class=\"strong\">Marco</span>: I do tend to swim against the tide.  Even when I was little, I used to do my own thing and it would irritate my parents."}, {"time": "57300", "image": "engenn6le12ob08re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa</span>: Sally says you definitely tend to stand out from the crowd.<br>\n<span class=\"strong\">Marco</span>: I don't want to be just ordinary ... like you.<br>\n<span class=\"strong\">Vanessa</span>: Don't be rude! You should learn some social etiquette.<br>\n<span class=\"strong\">Marco</span>: I am what I am ... take it or leave it. What's dessert? Could you look in the fridge?<br>\n<span class=\"strong\">Vanessa</span>: A cold shoulder."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}, {"contents": [{"type": "video", "value": {"images": [{"time": "0", "image": "", "text": "An Informal Letter <br><br></li><li>Use a casual greeting.\n</li><li>Use informal language.\n</li><li>Use linking words.\n</li><li>End the letter in an informal way.", "id": 0}], "video_src": "engenn6le12ob08re3vid01"}}], "template_override": 1, "title": "", "type": "video", "id": 2, "_data": []}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Vanessa and Marco's First Argument"}, {"type": "unit_name", "content": "The Letter"}, {"type": "position", "content": 8}, {"type": "origin", "content": "scholar > Around the World > Galapagos Islands"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Describe routines and regular activities in a wider range of social and work contexts."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le12ob08re1img01.jpg"}, {"contents": [{"type": "heading", "content": "Writing a Letter"}, {"type": "describer", "content": "When you write a letter to a friend, you should include:</p> <ul> <li>A casual greeting like Dear Sally or Hey Peter</li> <li>Begin your letter with some general statements.</li> <li>Letter to friends are informal. Use appropriate language and contractions.</li> <li>Think about words you could use to link sentences together like <span class=\"italic\">anyway, so</span> and <span class=\"italic\">by the way</span>.</li> <li>Informal letter can also sound more like a conversation. For example: <span class=\"italic\">Can you believe his behavior? I can't take him anywhere.</span></li> <li>End your letter in an informal way. Example: Love, and Cheers, </li></ul>"}, {"type": "example", "content": "What do you think I should do?"}, {"type": "example", "content": "I'll fill you in with the details when I see you next week."}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Talking About Past Habits (used to/would)"}, {"type": "describer", "content": "<span class=\"strong\">Would</span> and <span class=\"strong\">used to</span> have rather similar meanings. They are both used to describe something that happened regularly in the past but doesn't happen any longer.</br> However, there is an important difference between <span class=\"strong\">used to</span> and <span class=\"strong\">would</span>. "}, {"type": "text", "content": "<span class=\"strong\">Would</span> is not used unless you know that the time frame is in the past, while <span class=\"strong\">used to</span> does not require this.</br> Read the following example:</br> <span class=\"italic\">We would visit India every summer when we were children. </span> </p>However, when <span class=\"strong\">used to</span> is replaced with would, the same example becomes ungrammatical:</br> <span class=\"italic\">We used to visit every summer when we were children</span>."}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "caramelized"}, {"type": "definition", "content": "to cook something slowly until it is brown and sweet"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: The caramelized apples were an unexpected treat!"}, {"type": "audio", "content": "engenn6le12ob08aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you hear in a conversation over a meal."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "on your toes"}, {"type": "definition", "content": "to maintain your attention and energy in one place"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: You always need to be on your toes with Marco."}, {"type": "audio", "content": "engenn6le12ob08aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "spork"}, {"type": "definition", "content": "an eating utensil that is both a spoon and a fork"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Marco has a spork in his back pocket."}, {"type": "audio", "content": "engenn6le12ob08aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "unconventional"}, {"type": "definition", "content": "not traditional or usual"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: His behavior was a little unconventional."}, {"type": "audio", "content": "engenn6le12ob08aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to swim against the tide"}, {"type": "definition", "content": "to not follow others' ideas and beliefs"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I tend to swim against the tide."}, {"type": "audio", "content": "engenn6le12ob08aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to stand out from the crowd"}, {"type": "definition", "content": "to be different"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I don't want to stand out from the crowd."}, {"type": "audio", "content": "engenn6le12ob08aud06"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "social etiquette"}, {"type": "definition", "content": "behavior one has around others"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Samuel has very poor social etiquette."}, {"type": "audio", "content": "engenn6le12ob08aud07"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "cold shoulder"}, {"type": "definition", "content": "to not pay attention to someone for a reason, to ignore"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Vanessa gave Marco a cold shoulder."}, {"type": "audio", "content": "engenn6le12ob08aud08"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "appalling"}, {"type": "definition", "content": "terrible, shocking"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: His behavior has been appalling."}, {"type": "audio", "content": "engenn6le12ob08aud09"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "at one's wits' end"}, {"type": "definition", "content": "to be upset after trying every possible solution with no success"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I am at my wits' end with Marco."}, {"type": "audio", "content": "engenn6le12ob08aud10"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write a 10-12 line dialogue between you and a friend."}, {"type": "text", "content": "Have your friend describe the personality and behavior of a person they know. Do they have any bad habits? Are they unconventional?"}, {"type": "text", "content": "Give the friend some advice on how to react."}, {"type": "text", "content": "Read the dialogue aloud with a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write a dialogue about personality and behavior."}, {"type": "text", "content": "I give a friend some advice and suggestions."}, {"type": "text", "content": "I read a dialogue about behaviors aloud with a partner."}]}]}