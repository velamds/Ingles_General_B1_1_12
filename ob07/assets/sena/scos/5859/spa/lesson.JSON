ontent": ""}], "type": "question"}]}], "type": "RSLT", "id": 11, "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le12ob07re2img07.jpg", "audiosrc": "engenn6le12ob07re2aud01", "images": [{"time": "0", "image": "engenn6le12ob07re2img07.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le12ob07re2img07.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Mmm ... this stir-fry smells delicious! Cheers to the cook!<br>\n<span class=\"strong\">Marco</span>: Cheers to you, my sweet. You are incredibly talented in the kitchen and I have a lot to learn from you. <br>\n<span class=\"strong\">Vanessa</span>: You're right - your stir-fry is the best and I did learn a lot watching you. You cook so effortlessly. It is something to watch!"}, {"time": "20000", "image": "engenn6le12ob07re2img08.jpg", "id": 2, "text": "<span class=\"strong\">Marco</span>: So, how's Sally doing? Is she back from her travels?<br>\n<span class=\"strong\">Vanessa</span>: Yeah, she's back and as vivacious as ever. She seems refreshed and thrilled to be back.<br>\n<span class=\"strong\">Marco</span>: How busy is Peter these days? <br>\n<span class=\"strong\">Vanessa</span>: He's waiting to hear back from a job he applied to. He's so nervous about it. I admire how tenacious he is. When he sees something he wants, he goes for it."}, {"time": "42700", "image": "engenn6le12ob07re2img08.jpg", "id": 3, "text": "<span class=\"strong\">Marco</span>: Kind of like me, I guess. How happy is John, now that he is getting married?<br>\n<span class=\"strong\">Vanessa</span>: Peter gets e-mails from him now and again. He sounds happy. John is such a gregarious guy. I'm not surprised he found love on a cruise ship!"}]}}], "template_override": 1, "title": "", "type": "audio", "id": 2, "_data": []}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Vanessa and Marco's First Argument"}, {"type": "unit_name", "content": "It's All in The Past"}, {"type": "position", "content": 7}, {"type": "origin", "content": "scholar > Around the World > Around the World"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Identify and provide solutions to problems in a range of social contexts."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le12ob07re1img01.jpg"}, {"contents": [{"type": "heading", "content": "Questions With How + Adjectives"}, {"type": "describer", "content": "You use <span class=\"italic\">How</span> + <span class=\"italic\">adjective</span> in a question if you want to know how someone or something is."}, {"type": "text", "content": "You can use these types of questions when you catch up with someone and ask about other friends or family."}, {"type": "table", "content": "{\"rows\":5,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Question\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How old\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Asking about age\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How old are you?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How tall\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Asking about height\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How tall is he?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How far\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Asking about distance\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How far is it from here?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How busy\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Asking about amount of work\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How busy are you these days?\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "example", "content": "How busy is Peter these days?"}, {"type": "example", "content": "How happy is John, now that he is getting married?"}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Talking About People's Behavior and Personality"}, {"type": "describer", "content": "When you talk about  friends and family, you often describe their behavior and their personalities."}, {"type": "example", "content": "You are incredibly talented."}, {"type": "example", "content": "You cook so effortlessly."}, {"type": "example", "content": "He's nervous about the job."}, {"type": "example", "content": "I admire how tenacious he is."}, {"type": "text", "content": "Behavior is the way a person acts or conducts themselves. </br><span class=\"italic\">Example: Tom is usually relaxed, but today he seems nervous.</span></p> Personality is a person's general character (they way they are). </br><span class=\"italic\">Example: Sandra is a tidy person. Her apartment is always clean and neat.</span>  "}, {"type": "text", "content": "We use adjectives and adverbs to talk about behavior and personality. Remember that adjectives describe a person - their personality, while adverbs describe how a person does something - their behaviour. <br/> For example:<br/> <span class=\"italic\"> She's very intelligent.</span> (adjective)<br/><span class=\"italic\"> She writes intelligently.</span> (adverb)"}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "effortlessly"}, {"type": "definition", "content": "without effort; easily"}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: You cook so effortlessly!"}, {"type": "audio", "content": "engenn6le12ob07aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you use to talk about people."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "vivacious"}, {"type": "definition", "content": "lively; full of energy"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Sally is so vivacious."}, {"type": "audio", "content": "engenn6le12ob07aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "refreshed"}, {"type": "definition", "content": "energized; feeling rested"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She is refreshed after her travels abroad."}, {"type": "audio", "content": "engenn6le12ob07aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "thrilled"}, {"type": "definition", "content": "very excited; very happy"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She's thrilled to be back."}, {"type": "audio", "content": "engenn6le12ob07aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "tenacious"}, {"type": "definition", "content": "strong; powerful; not giving up easily"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I admire how tenacious he is."}, {"type": "audio", "content": "engenn6le12ob07aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "gregarious"}, {"type": "definition", "content": "outgoing; lively"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: John is so gregarious."}, {"type": "audio", "content": "engenn6le12ob07aud06"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Think of three friends you know well."}, {"type": "text", "content": "Think of 4 adjectives to describe each person."}, {"type": "text", "content": "Describe your friends to your partner. Do you they have similar qualities?"}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I can describe my friends to my partner."}, {"type": "text", "content": "My partner and I can discuss the similarities between our friends."}, {"content": ""}]}]}