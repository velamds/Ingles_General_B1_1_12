contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "text", "content": "Instructions: Listen to the audio. Type in the missing words. "}], "type": "post_instructions"}]}, {"template_override": 1, "stimuli_ids": [], "questions": [{"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}], "id": 0, "_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}]}], "type": "RSLT", "id": 11, "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le12ob01re2img06.jpg", "audiosrc": "engenn6le12ob01re2aud01", "images": [{"time": "0", "image": "engenn6le12ob01re2img06.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le12ob01re2img06.jpg", "id": 1, "text": "<span class=\"strong\">Marco</span>: It's great to see you, Vanessa. </br>\n<span class=\"strong\">Vanessa</span>: It's great to see you, too! I've anxiously awaited your visit ... Have you been to Massachusetts before? </br>\n<span class=\"strong\">Marco</span>: I used to come visit here when I was a kid. We would come and visit my Uncle Doug - he lived here for ages. I remember he used to collect snowglobes. He would show us his collection whenever we visited."}, {"time": "21000", "image": "engenn6le12ob01re2img06.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: Really? I had no idea you had family in the U.S. </br>\n<span class=\"strong\">Marco</span>: I usually keep a little mystery in my relationships - to keep things interesting. My mother would always tell me to not reveal too much at the start of a relationship. </br>\n<span class=\"strong\">Vanessa</span>: That's ... strange. </br>\n<span class=\"strong\">Marco</span>: Strange? I thought you liked a little mystery in a man."}, {"time": "40700", "image": "engenn6le12ob01re2img07.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa</span>: There's mystery, and then there's withholding information!</br>\n<span class=\"strong\">Marco</span>: Wow - you are clearly overly sensitive about this, V.</br>\n<span class=\"strong\">Vanessa</span>: Me? I gladly share personal details with people that I'm supposedly in love with! Look here in my study - I have a collection of snowglobes, too! What do you think of that?</br>\n<span class=\"strong\">Marco</span>: It's my way or the highway, honey."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 2, "_data": []}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Vanessa and Marco's First Argument"}, {"type": "unit_name", "content": "My Way or the Highway"}, {"type": "position", "content": 1}, {"type": "origin", "content": "scholar > Around the World > Jazzing it up in Montreal"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Describe  routines and regular activities in a wider range of social and work contexts."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le12ob01re1img01.jpg"}, {"contents": [{"type": "heading", "content": "Used to and Would to Talk About Past Habits"}, {"type": "describer", "content": "When you talk about repetitive events in the past, you can use <span class=\"strong\">used to</span> or <span class=\"strong\">would</span>. We usually use these expressions when we talk about memories from our childhood or earlier days."}, {"type": "text", "content": "<span class=\"italic\">Example:<br> I used to come visit here when I was a kid.<br>  We would come and visit my Uncle Doug - he lived here for ages.</span>"}, {"type": "text", "content": "You use <span class=\"strong\">used to</span> with you refer to conditions, states or actions that do not happen anymore. <br><br><span class=\"italic\">Examples:<br> I used to have many friends at school.<br> My parents used to be strict with me.<br> We used to like the same type of music.</span>"}, {"type": "text", "content": "You use <span class=\"strong\">would</span> for actions that were repetitive in the past. However, you do not use ot to talk about past state. <br><br><span class=\"italic\">Example:<br> He would study for hours in the garden.<br> My mother would always tell me to not reveal too much at the start of a relationship.</span>"}, {"type": "text", "content": "Use the infinitive verb with these expressions: <br>Used to + verb (I used to live here). <br>Would + verb (We would talk for hours)"}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Rooms in a House"}, {"type": "describer", "content": "There are many different rooms in a typical North American house. Each room has its own purpose. Here is a list of rooms and some information about each. How are they different from rooms in your country?"}, {"type": "example", "content": "Look here in my study - I have a collection of snowglobes."}, {"type": "example", "content": "I bought new tools for my kitchen."}, {"type": "example", "content": "Where are you? I'm in the bedroom!"}, {"type": "table", "content": "{\"rows\":8,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Room\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Purpose\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Living room\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"A room where people come together to talk and watch TV.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Kitchen\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"A room where people cook and sometimes eat meals. The kitchen is usually considered to to the \u201cheart\u201d of the home.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Dining room\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"A room where people eat meals. It is usually for formal meals with guests.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Bathroom\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"A room where people use the toilet, take showers/baths and wash their hands. There is usually more than one bathroom in a house.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Bedroom\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"A room where people sleep and get dressed. There is usually more than one bedroom.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Den / Study\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"A small room used for studying, reading or relaxing.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Laundry room\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"A room where people wash and dry their clothes.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "anxiously"}, {"type": "definition", "content": "wanting something very much"}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: I'm anxiously preparing for your visit."}, {"type": "audio", "content": "engenn6le12ob01aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you use to talk about people's behavior."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "to await"}, {"type": "definition", "content": "wait for an event "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I've anxiously awaited your visit."}, {"type": "audio", "content": "engenn6le12ob01aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "snowglobe "}, {"type": "definition", "content": "a toy that contains water and snow in a clear globe that creates a \u201csnowing\u201d scene when you shake it."}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: My uncle used to collect snowglobes as souvenirs."}, {"type": "audio", "content": "engenn6le12ob01aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to reveal "}, {"type": "definition", "content": "to show"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Don't reveal too much at the beginning of the relationship."}, {"type": "audio", "content": "engenn6le12ob01aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "study"}, {"type": "definition", "content": "a small room to read or study in"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I keep my collection of snowglobes in my study."}, {"type": "audio", "content": "engenn6le12ob01aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "overly "}, {"type": "definition", "content": "excessively; unreasonably"}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: I'm overly sensitive today."}, {"type": "audio", "content": "engenn6le12ob01aud06"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Make a list of things that you used to and things that you do now."}, {"type": "text", "content": "Compare your list with a partner."}, {"type": "text", "content": "Discuss the differences. "}, {"type": "text", "content": "Ask follow-up questions to keep the conversation going."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I make a list of past and present habits."}, {"type": "text", "content": "I share my list with my partner."}, {"type": "text", "content": "I ask follow-up questions to keep the conversation going."}]}]}