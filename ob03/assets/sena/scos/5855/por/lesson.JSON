{"type": "sena", "_data": [{"contents": [{"type": "lesson_name", "content": "Vanessa and Marco's First Argument"}, {"type": "unit_name", "content": "It's Not Me, It's You"}, {"type": "position", "content": 3}, {"type": "origin", "content": "scholar > Around the World > Jazzing it up in Montreal"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Describe  routines and regular activities in a wider range of social and work contexts."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le12ob03re1img01.jpg"}, {"contents": [{"type": "heading", "content": "Expressing What is Necessary"}, {"type": "describer", "content": "You use <span class=\"strong\">have got to</span> to say what you or another person needs to do. <span class=\"strong\">Have got to</span> is more commonly used in British English."}, {"type": "table", "content": "{\"rows\":2,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Subject<br>I/they/we/you<br>She/he\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<br><span class=\\\"strong\\\">+ have got to/<br>has got to</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<br>+ verb in base form + complement.\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "example", "content": "<span class=\"strong\">You have got to</span> tone it down."}, {"type": "example", "content": "<span class=\"strong\">I've got to</span> get my feelings under control."}, {"type": "example", "content": "<span class=\"strong\">He's got to</span> get his feelings under control."}, {"type": "example", "content": "<span class=\"strong\">She's got to</span> know what she wants."}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Used to and Would to Talk About Past Habits"}, {"type": "describer", "content": " "}, {"type": "text", "content": "You talk about regular events in the past, you can use <span class=\"strong\">used to</span> or <span class=\"strong\">would</span>.<br><br> <span class=\"italic\">Example:<br> We used to think we were meant to be together.<br> We'd say we were soul mates.</span>"}, {"type": "text", "content": "You use <span class=\"strong\">used to</span> with you refer to conditions, states or actions that do not happen anymore. <br><br><span class=\"italic\">Example:<br> You used to be more fun ... what happened?<br> We used to make plans together.</span>"}, {"type": "text", "content": "You use <span class=\"strong\">would</span> for actions that were repetitive in the past. However, you do not use to to talk about past state.<br><br> <span class=\"italic\">Example:<br> In San Francisco, you would let me decide things for us.<br> We'd spend more time together.</span>"}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "demanding"}, {"type": "definition", "content": "hard to please; tiresome"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Are you usually this demanding?"}, {"type": "audio", "content": "engenn6le12ob03aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you use in an argument."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "to phrase"}, {"type": "definition", "content": "to say; to put into words"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: You should be more careful about how you phrase things."}, {"type": "audio", "content": "engenn6le12ob03aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to throw someone out "}, {"type": "definition", "content": "to make someone leave a place"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: You're dangerously close to me throwing you out."}, {"type": "audio", "content": "engenn6le12ob03aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "stubborn"}, {"type": "definition", "content": "unwilling to change your mind"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You're being very stubborn right now."}, {"type": "audio", "content": "engenn6le12ob03aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to get carried away "}, {"type": "definition", "content": "to be overcome with emotion "}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Sometimes I get a little carried away."}, {"type": "audio", "content": "engenn6le12ob03aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to get something under control"}, {"type": "definition", "content": "to gain control of a situation after losing it for a short time"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I've got to get my feelings under control."}, {"type": "audio", "content": "engenn6le12ob03aud06"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write down 6 adjectives and 6 adverbs on different pieces of paper."}, {"type": "text", "content": "With a partner, mix up the words together."}, {"type": "text", "content": "Choose a word from the pile and use that word to start a conversation."}, {"type": "text", "content": "Talk about yourself or other people."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write down 6 adjectives and 6 adverbs."}, {"type": "text", "content": "I use these words to start a conversation with my partner."}, {"type": "text", "content": "I talk about myself and other people."}]}], "labs": [{"exercises": [{"template_override": 1, "stimuli_ids": [0], "type": "WLC", "questions": [], "img_path": "", "id": 0, "_data": [{"contents": [{"type": "skill", "content": "Vocabulary and Grammar"}, {"type": "skill", "content": "Reading"}, {"type": "Learning Outcomes", "content": "I can talk about people's behavior and personality."}, {"type": "Learning Outcomes", "content": "I can talk about  past and present habits."},