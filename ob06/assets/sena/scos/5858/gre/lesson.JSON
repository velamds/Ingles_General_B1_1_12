 [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "text", "content": "Instructions: \n<span class=\"bullet\">Proofread the sentence. </span> \n<span class=\"bullet\">Click on the incorrect word. </span> \n<span class=\"bullet\">Type in the correct word to complete the sentence. </span> \n<span class=\"bullet\">Use capital letters where necessary.</span>"}], "type": "post_instructions"}, {"type": "template_override", "content": 2}]}, {"template_override": 1, "stimuli_ids": [], "questions": [{"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 1}], "id": 0, "_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}]}], "type": "RSLT", "id": 11, "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le12ob06re2img07.jpg", "audiosrc": "engenn6le12ob06re2aud01", "images": [{"time": "0", "image": "engenn6le12ob06re2img07.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le12ob06re2img07.jpg", "id": 1, "text": "<span class=\"strong\">Marco</span>: Speaking of dinner ... Why don't I make you dinner tonight? I'd like to show you how sincere my apology is.<br>\n<span class=\"strong\">Vanessa</span>: Step into my kitchen, darling. I just bought a bunch of new tools! You ought to take a look!<br>\n<span class=\"strong\">Marco</span>: Hmm, I see you have a whole set of chef's knives ... wow! I'm going to have to try some of those tonight."}, {"time": "20000", "image": "engenn6le12ob06re2img07.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: I got a new wok and garlic press, too! You've got to make your famous stir-fry! <br>\n<span class=\"strong\">Marco</span>: You can learn a few things watching me, you know. You'd better watch closely.<br>\n<span class=\"strong\">Vanessa</span>: Are you saying that I can't make a stir-fry? That's insulting, you know.<br>\n<span class=\"strong\">Marco</span>: Come on, V. I didn't mean it like that! I'm sorry, again!"}, {"time": "39500", "image": "engenn6le12ob06re2img08.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa</span>: Don't be a jerk, Marco. Ok, let's make up. Why don't you take my new cutting board and start your creation! I shouldn't have reacted that way.<br>\n<span class=\"strong\">Marco</span>: That's alright ... I'm sorry for being arrogant. <br>\n<span class=\"strong\">Vanessa</span>: You couldn't help it, I know. Don't worry about it.<br>\n<span class=\"strong\">Marco</span>: That's my girl. Ok, I'd better get cracking!"}]}}], "template_override": 1, "title": "", "type": "audio", "id": 2, "_data": []}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Vanessa and Marco's First Argument"}, {"type": "unit_name", "content": "Let's Make Up"}, {"type": "position", "content": 6}, {"type": "origin", "content": "scholar > Around the World > Around the World"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Identify and provide solutions to problems in a range of social contexts."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le12ob06re1img01.jpg"}, {"contents": [{"type": "heading", "content": "Expressing What is Necessary"}, {"type": "describer", "content": "You use <span class=\"strong\">ought to</span> and <span class=\"strong\">had better</span> to say what you or another person needs to do. A short form for <span class=\"strong\">had better</span> is <span class=\"strong\">'d better</span>."}, {"type": "table", "content": "{\"rows\":4,\"columns\":1,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Examples:\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You <span class=\\\"strong\\\">ought to</span> take a look! <br> You<span class=\\\"strong\\\">'d better</span> watch closely.<br> I<span class=\\\"strong\\\">'d better</span> get cracking!\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Apologizing"}, {"type": "describer", "content": "You can use different phrases to make and accept an apology."}, {"type": "text", "content": "You apologize when you know you have hurt someone's feelings.  There are polite and casual phrases to make and accept an apology."}, {"type": "table", "content": "{\"rows\":3,\"columns\":3,\"cells\":[\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Making an Apology\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Accepting an Apology\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Polite\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Pardon me for this ...</br> Please, forgive me for my ...</br> Please, accept my apologies for ...</br> Please, forgive me for ...</br> I'd like to apologize for ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I quite understand. </br>You couldn't help it.</br> That's all right.</br> Never mind. </br>Don't apologize.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Casual\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I'm so sorry for ... </br>I shouldn't have ...</br> It's all my fault. </br>I apologize for ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It doesn't matter. </br>Don't worry about it. </br>Don't mention it. </br>That's OK. </br>Forget about it. </br>Don't worry about it. </br>No harm done.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "<span class=\"strong\">Ben</span>: I'm sorry for hurting your feelings. </br><span class=\"strong\">Cathy</span>: That's OK. Don't worry about it."}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "sincere"}, {"type": "definition", "content": "honest; truthful"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I want to show you how sincere my apology is."}, {"type": "audio", "content": "engenn6le12ob06aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you use in the kitchen."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "chef's knives"}, {"type": "definition", "content": "special knives for cooking"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I see you have a whole set of chef's knives."}, {"type": "audio", "content": "engenn6le12ob06aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "wok "}, {"type": "definition", "content": "a special frying pan used for making stir-fry"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I got a new wok!"}, {"type": "audio", "content": "engenn6le12ob06aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "garlic press"}, {"type": "definition", "content": "a tool used to crush garlic"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Do you like my new garlic press?"}, {"type": "audio", "content": "engenn6le12ob06aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "cutting board"}, {"type": "definition", "content": "a special board used to cut bread, vegetables or other food"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Why don't you use my new cutting board?"}, {"type": "audio", "content": "engenn6le12ob06aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "insulting"}, {"type": "definition", "content": "hurting someone's feelings"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You can be insulting sometimes."}, {"type": "audio", "content": "engenn6le12ob06aud06"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "creation "}, {"type": "definition", "content": "something that you make or create"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Come into my kitchen and start your creation!"}, {"type": "audio", "content": "engenn6le12ob06aud07"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Think of a recipe you know well. "}, {"type": "text", "content": "Explain how to make it to your partner."}, {"type": "text", "content": "Include what kitchen tools you need."}, {"type": "text", "content": "Try to use the structure \u201cgoing to have to/got to\u201d."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I explain how to make my famous creation to my partner."}, {"type": "text", "content": "I talk about the tools I need to make it."}, {"type": "text", "content": "I talk about necessity. "}]}]}