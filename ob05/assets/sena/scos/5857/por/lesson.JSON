"incorrect"}, {"contents": {"type": "", "content": "to make it up to her. "}, "type": "post_question"}, {"type": "objective", "content": "secondary_8"}]}, {"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": "to"}], "id": 1, "selected": 0}], "id": 1, "_data": [{"contents": [{"type": "audio", "content": "engenn6le12ob05re6aud10"}, {"type": "text", "content": "She's got"}], "type": "question"}, {"contents": [{"type": "text", "content": "too"}], "type": "incorrect"}, {"contents": {"type": "", "content": "apologize for saying the things she said."}, "type": "post_question"}, {"type": "objective", "content": "secondary_8"}]}], "type": "GIW", "id": 10, "_data": [{"contents": [{"type": "text", "content": "Jesse talks about his friends."}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "text", "content": "Instructions: \n<span class=\"bullet\">Listen to the audio. </span> \n<span class=\"bullet\">Proofread the sentence. </span> \n<span class=\"bullet\">Click on the incorrect word. </span> \n<span class=\"bullet\">Type in the correct word to complete the sentence.</span>\n<span class=\"bullet\">Use capital letters where necessary.</span>"}], "type": "post_instructions"}]}, {"template_override": 1, "stimuli_ids": [], "questions": [{"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}], "id": 0, "_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}]}], "type": "RSLT", "id": 11, "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le12ob05re2img05.jpg", "audiosrc": "engenn6le12ob05re2aud01", "images": [{"time": "0", "image": "engenn6le12ob05re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le12ob05re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: I'm sorry I haven't given you a chance, Marco. I'd better stop being so quick to judge. I know you're trying. You came all the way out here to see me and I'm foolishly wasting time being overly sensitive.<br>\n<span class=\"strong\">Marco</span>: No, V. I'm sorry. I apologize for saying the things I said. I know I can be annoyingly pushy at times. I ought to be more aware of how my words come across."}, {"time": "24000", "image": "engenn6le12ob05re2img05.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: It's ok. I've got to stop being so needy. <br>\n<span class=\"strong\">Marco</span>: You're not needy ... you're just emotional. That's ok. I've got to respect your feelings and not belittle them. <br>\n<span class=\"strong\">Vanessa</span>: I appreciate you acknowledging that. It really makes me love you more. You can be so understanding and sweet. I'm going to have to remember that ..."}, {"time": "45000", "image": "engenn6le12ob05re2img13.jpg", "id": 3, "text": "<span class=\"strong\">Marco</span>: You'd better not lose your sassiness ... I like it! It's an endearing quality, you know. Keeps things spicy - you know, I like spice in my food and in my women!<br>\n<span class=\"strong\">Vanessa</span>: I'm going to have to remember that when I make dinner next."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Vanessa and Marco's First Argument"}, {"type": "unit_name", "content": "I'm Sorry"}, {"type": "position", "content": 5}, {"type": "origin", "content": "scholar > Around the World > La Tomatina"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Identify and provide solutions to problems in a range of social contexts."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le12ob05re1img01.jpg"}, {"contents": [{"type": "heading", "content": "Apologizing"}, {"type": "describer", "content": "You can use different phrases to make and accept an apology."}, {"type": "text", "content": "You apologize when you know you have hurt someone's feelings.  There are polite and casual phrases to make and accept an apology."}, {"type": "table", "content": "{\"rows\":3,\"columns\":3,\"cells\":[\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Making an Apology\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Accepting an Apology\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Polite\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Pardon me for this ...</br> Please, forgive me for my ...</br> Please, accept my apologies for ... </br>Please, forgive me for ... </br>I'd like to apologize for ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I quite understand. </br>You couldn't help it. </br>That's all right.</br> Never mind.</br> Don't apologize.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Casual\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I'm so sorry for ...</br> I shouldn't have ...</br> It's all my fault. </br>I apologize for ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It doesn't matter. </br>Don't worry about it. </br>Don't mention it. </br>That's OK. </br>Forget about it. </br>Don't worry about it. </br>No harm done.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "example", "content": "<span class=\"strong\">Ben</span>: I'm sorry for hurting your feelings.</br> <span class=\"strong\">Cathy</span>: That's OK. Don't worry about it."}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Offering Advice"}, {"type": "describer", "content": "There are several ways to give advice and each one uses a slightly sentence structure. You can use phrases such as <span class=\"strong\">had better</span>, <span class=\"strong\">ought to</span>, and <span class=\"strong\">might want to</span> to talk about what is advisable (what you think should be done)."}, {"type": "text", "content": "You can use these phrases to give advice."}, {"type": "text", "content": "<span class=\"strong\">Subject + had better + verb</span>: You'd better not lose your sassiness."}, {"type": "text", "content": "<span class=\"strong\">Subject + ought to + verb</span>: I ought to be more aware of how my words come across."}, {"type": "text", "content": "<span class=\"strong\">Subject + might want to + verb</span>: you might want to remember that next time."}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "foolishly"}, {"type": "definition", "content": "in a foolish way; without thinking"}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: I'm foolishly wasting my time."}, {"type": "audio", "content": "engenn6le12ob05aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you use when you apologize."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "to be aware"}, {"type": "definition", "content": "to realize or know something"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I ought to be more aware of what I say."}, {"type": "audio", "content": "engenn6le12ob05aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to come across"}, {"type": "definition", "content": "to communicate; to give a particular meaning"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Be careful how your words come across."}, {"type": "audio", "content": "engenn6le12ob05aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "needy"}, {"type": "definition", "content": "emotionally desperate"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I've got to stop being so needy."}, {"type": "audio", "content": "engenn6le12ob05aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "emotional "}, {"type": "definition", "content": "relating to someone's emotions"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You're not needy - you're just emotional."}, {"type": "audio", "content": "engenn6le12ob05aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to belittle "}, {"type": "definition", "content": "to make someone feel small and unimportant"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I've got to respect your feelings and not belittle them."}, {"type": "audio", "content": "engenn6le12ob05aud06"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "endearing"}, {"type": "definition", "content": "lovable; sweet"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You have many endearing qualities."}, {"type": "audio", "content": "engenn6le12ob05aud07"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "sassiness"}, {"type": "definition", "content": "liveliness; full of spirit"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I like your sassiness."}, {"type": "audio", "content": "engenn6le12ob05aud08"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Listen to the song \u201cIt's too late to apologize\u201d by One Republic."}, {"type": "text", "content": "Think about how the songs makes you feel."}, {"type": "text", "content": "Discuss the song with your partner. Do you have the same feelings about it?"}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I listen to the song in English."}, {"type": "text", "content": "I think about how the song makes me feel."}, {"type": "text", "content": "I discuss the song with my partner."}]}]}