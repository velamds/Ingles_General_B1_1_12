 {"stimuli_ids": [], "template_override": 1, "questions": [{"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}]}], "type": "RSLT", "id": 11, "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le12ob11re2img06.jpg", "audiosrc": "engenn6le12ob11re2aud01", "images": [{"time": "0", "image": "engenn6le12ob11re2img06.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le12ob11re2img06.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Hello?<br>\n<span class=\"strong\">Marco</span>: Hi, it's me. How are you? <br>\n<span class=\"strong\">Vanessa</span>: I've been better, but I've had time to cool off. How are you?<br>\n<span class=\"strong\">Marco</span>: I've thought about the way I acted, and I'm so sorry. You ought to break up with me, V. I'm behaving foolishly."}, {"time": "18700", "image": "engenn6le12ob11re2img07.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: You're going to have to keep the promises that you make from now on. This is your last chance, Marco. You sound sincere.<br>\n<span class=\"strong\">Marco</span>: You mean, you've decided to come back? Oh, you've made me so happy! I'd better get your place cleaned up! <br>\n<span class=\"strong\">Vanessa</span>: What do you mean?"}, {"time": "36000", "image": "engenn6le12ob11re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Marco</span>: Um, your kitchen and study are a little messy. I used to work out when I wanted to feel refreshed. Now, I cook when I get emotional.<br>\n<span class=\"strong\">Vanessa</span>: I would always do the opposite. I would eat when I got emotional. Now, I just pack and leave. It's not a good way to handle things. <br>\n<span class=\"strong\">Marco</span>: Come home and we'll have a proper reunion!  I'm anxiously awaiting your return!<br>\n<span class=\"strong\">Vanessa</span>: Ok. I'm sorry for being so stubborn."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Vanessa and Marco's First Argument"}, {"type": "unit_name", "content": "How it Turned Out"}, {"type": "position", "content": 11}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Describe  routines and regular activities in a wider range of social and work contexts."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le12ob11re1img01.jpg"}, {"contents": [{"type": "heading", "content": "The Present Perfect Tense vs. The Simple Past Tense"}, {"type": "describer", "content": "Let's compare the simple past and present perfect:"}, {"type": "text", "content": "<span class=\"strong\">Simple Past</span>  <br>It refers to an action that occurred at a definite time in the past.   <br><br>Examples:  <br>I said things that I didn't mean yesterday. <br>He caught me at a bad time last Saturday. <br/><br/> These actions are finished when we have a definite time (yesterday, last Saturday).<br><br>  You can use other time expressions + simple past"}, {"type": "table", "content": "{\"rows\":1,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"He did that ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"in 2000<br>                                         last night<br>                                         last weekend<br>                                         on January 2nd<br>                                          three days ago\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "text", "content": "<span class=\"strong\">Present Perfect</span><br><br>It refers to an action that happened at an indefinite time in the past.<br><br>  Examples:  <br/>You guys have always made up and moved on.<br>  I have said terrible things.<br><br>  These actions can continue to the present."}, {"type": "table", "content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We have talked about getting married ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"for years.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We have been a couple ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"since 2014.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I have waited for Vanessa ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"since she took off.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"She has ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"never taken her suitcases.\\\"}\"],\"styles\":\" intro_table_border\"}"}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Used to and Would to Talk About Past Habits"}, {"type": "describer", "content": "<span class=\"strong\">Would</span> and <span class=\"strong\">used to</span> have rather similar meanings. They are both used to describe something that happened regularly in the past but doesn't happen any longer.</br> However, there is an important difference between <span class=\"strong\">used to</span> and <span class=\"strong\">would</span>. "}, {"type": "example", "content": "I would always do the opposite. I would eat when I got emotional."}, {"type": "example", "content": "I used to work out when I wanted to feel refreshed."}, {"type": "text", "content": "<span class=\"strong\">Would</span> is not used unless you know that the time frame is in the past, while <span class=\"strong\">used to</span> does not require this.</br> Read the following example:</br> <span class=\"italic\">We would visit India every summer when we were children.</span></p>  However, when <span class=\"strong\">used to</span> is replaced with would, the same example becomes ungrammatical:</br> <span class=\"italic\">We used to visit every summer when were children.</span>"}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "foolishly "}, {"type": "definition", "content": "in a foolish way; without thinking"}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: I'm foolishly wasting my time."}, {"type": "audio", "content": "engenn6le12ob11aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words to review."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "emotional"}, {"type": "definition", "content": "relating to someone's emotions"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You're not needy - you're just emotional."}, {"type": "audio", "content": "engenn6le12ob11aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "refreshed"}, {"type": "definition", "content": "energized; feeling rested"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She is refreshed after her travels abroad."}, {"type": "audio", "content": "engenn6le12ob11aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "reunion"}, {"type": "definition", "content": "when two or more people come together after a long period of time"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I would play our reunion over and over in my head."}, {"type": "audio", "content": "engenn6le12ob11aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to pack"}, {"type": "definition", "content": "to put things in a suitcase or bag for a trip"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I'm in my bedroom, packing my suitcase."}, {"type": "audio", "content": "engenn6le12ob11aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "stubborn"}, {"type": "definition", "content": "unwilling to change your mind"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You're being very stubborn right now."}, {"type": "audio", "content": "engenn6le12ob11aud06"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "anxiously"}, {"type": "definition", "content": "wanting something very much"}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: I'm anxiously preparing for your visit."}, {"type": "audio", "content": "engenn6le12ob11aud07"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to await"}, {"type": "definition", "content": "wait for an event "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I've anxiously awaited your visit."}, {"type": "audio", "content": "engenn6le12ob11aud08"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "study"}, {"type": "definition", "content": "a small room to read or study in"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I keep my collection of snowglobes in my study."}, {"type": "audio", "content": "engenn6le12ob11aud09"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "sincere"}, {"type": "definition", "content": "honest; truthful"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I want to show you how sincere my apology is."}, {"type": "audio", "content": "engenn6le12ob11aud10"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Talk to your partner about how you deal with being emotional."}, {"type": "text", "content": "Tell them about what you used to do and what you do now."}, {"type": "text", "content": "Ask follow-up questions to keep the conversation going."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk to my partner about how I deal with being emotional."}, {"type": "text", "content": "I talk about old and new habits."}, {"type": "text", "content": "I ask follow-up questions to keep the conversation going."}]}]}